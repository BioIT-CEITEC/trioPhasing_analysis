{
  "workflow_description": {
    "name":"trio_phasing_analysis",
    "version": 1.0,
    "label":"Trio Phasing Analysis",
    "type":"trio_phasing_analysis",
    "run_parameters": {
      "cpu": 32,
      "memory": 124
    },
    "inputs":[
      "mapped/{sample}.bam*"
    ],
    "outputs":[
      "config.json",
      "logs/*",
      "genomic_varcalls/*"
    ]
  },
  "general_params": [
    "entity_name",
    "sample_name"
  ],
  "requested_params": [
    "organism",
    "assembly"
  ],
  "gui_params" : {
    "primary": {
      "call_quality": {
        "label": "Minimum Phred-scaled quality score",
        "type": "string",
        "default": "30.0"
      }
    },
    "detailed": {
    },
    "samples": {
      "donor": {
        "label": "Trio ID",
        "type": "string",
        "default": ""
      },
      "origin_id": {
        "label": "mother/father/offspring",
        "type": "enum",
        "default": "mother",
        "list": {
          "mother": "mother",
          "father": "father",
          "offspring": "offspring"
        }
      }
    }
  }
}
